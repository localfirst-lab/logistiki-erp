# LogistiKI ERP - Environment Configuration Template
# Copy to .env and customize with your own parameters

# Google Gemini API Credentials (Required for Inbound Vision OCR & Pydantic AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=optional_backup_gemini_api_key

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Server Settings
HOST=0.0.0.0
PORT=5055
DEBUG=False

# Local Ollama / Private VPS Settings (Optional)
OLLAMA_ENABLED=False
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=qwen2.5:14b
